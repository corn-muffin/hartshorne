\begin{enumerate}
  \item[6.2.] {
      Let $X=\PP_k^1$, with $k$ an infinite field.
      \begin{enumerate}
        \item Show that there does not exist a projective object $\P\in \Mod(X)$, together with a surjective map $\P\to \O_X\to 0$. [\emph{Hint}: Consider surjections of the form $\O_V\to k(x)\to 0$, where $x\in X$ is a closed point, $V$ is an open neighborhood of $x$, and $\O_V=j_!(\O_X|_V)$, where $j:V\to X$ is the inclusion.]
        \item Show that there does not exist a projective object $\P$ in either $\QCoh(X)$ or $\Coh(X)$ together with a surjection $\P\to \O_X\to 0$ [\emph{Hint}: Consider surjections of the form $\L\to \L\otimes k(x)\to 0$, where $x\in X$ is a closed point, and $\L$ is an invertible sheaf on $X$.]
      \end{enumerate}
    }
\end{enumerate}

\begin{proof}
  (a) Suppose not, and take such a $\P\in \Mod(X)$ and surjective map $\phi:\P\surj \O_X$.
  Take a closed point $x\in X$, and let $U,V\ni x$ be neighborhoods of $x$ such that $U\not\subset V$ and $V\not\subset U$.
  Then we have a surjection $j_!(\O_X|_V)=:\O_V\surj k(x):=i_*(k(x))$, and hence the following diagram via the projective lifting property.
  \[
    \begin{tikzcd}
      \O_V\ar[r] &k(x)\ar[r]&0\\
                 &\O_X\ar[u,twoheadrightarrow]\\
                 &\P\ar[u,twoheadrightarrow, "\phi"']\ar[uul,dotted]
    \end{tikzcd}
  \] 
  Now, take $s\in \Gamma(U,\P)$.
  We have $\Gamma(U,\O_V)=0$ since $V\not\subset U$,so $\phi(s)\mapsto 0$ under $\O_X\surj k(x)$.
  But then $\im\phi_x\subset m_x\subsetneq \O_{X,x}$, contradicting surjectivity of $\phi$.

  (b) Suppose not, and take such a $\P\in \Mod(X)$ and surjective map $\P\to\O_X\to 0$.
  Fix $x\in X$ and consider the surjection $\O_X\to k(x)\to 0$.
  (Ex. 5.10) gives us $n>0$ such that both $\Gamma(X,\O_X(n))\to k(x)\to 0$ and $\Gamma(X,\P(n))\to \Gamma(X,\O_X(n))\to 0$ are surjective.
  Tensoring $\O_X\to k(x)\to 0$ with $\O_X(-n-1)$ gives us a surjection 
  \[
    \O_X(-n-1)\to k(x)\otimes \O_X(-n-1)\cong k(x)\to 0
  \]
  Once again, the projective criterion gives us a map $\P\to \O_X(-n-1)$ such that the following diagram commutes.
  \[
    \begin{tikzcd}
      \O_X(-n-1)\ar[r] &k(x)\ar[r]&0\\
                       &\O_X\ar[u,twoheadrightarrow] \\
                       &\P\ar[u,twoheadrightarrow]\ar[uul,dotted]
    \end{tikzcd}
  \] 
  We can tensor this diagram with $\O_X(n)$.
  \[
    \begin{tikzcd}
      \O_X(-1)\ar[r] &k(x)\ar[r]&0\\
                       &\O_X(n)\ar[u,twoheadrightarrow] \\
                       &\P(n)\ar[u,twoheadrightarrow]\ar[uul,dotted]
    \end{tikzcd}
  \] 
  Then the following diagram commutes.
  \[
    \begin{tikzcd}
      0=\Gamma(X,\O_X(-1))\ar[r] &k(x)\neq 0\\
                       &\Gamma(X,\O_X(n))\ar[u,twoheadrightarrow] \\
                       &\Gamma(X,\P(n))\ar[u,twoheadrightarrow]\ar[uul]
    \end{tikzcd}
  \] 
  However, this implies $0=\Gamma(X,\O_X(-1))\to k(x)\neq 0$ is a surjection, which is a contradiction.
\end{proof}

\begin{enumerate}
  \item[6.3.] {
      Let $X$ be a noetherian, and let $\F,\G\in \Mod(X)$.
      \begin{enumerate}
        \item If $\F,\G$ are both coherent, then $\sExt^i(\F,\G)$ is coherent, for all $i\geqs 0$.
        \item If $\F$ is coherent and $\G$ is quasi-coherent, then $\sExt^i(\F,\G)$ is quasi-coherent, for all $i\geqs 0$.
      \end{enumerate}
    }
\end{enumerate}

\begin{proof}
  (a) We begin by showing the result for $i=0$.
  Take an affine open $\Spec A\cong U\subset X$ and finitely generated $A$-modules $M,N$ such that $\F|_U\cong \wtilde{M}$ and $\G|_U\cong \wtilde{N}$.
  Then we have
  \begin{align*}
    \Hom_{\O_U}(\F|_U,\G|_U)\cong \Hom_A(M,N).
  \end{align*}
  We claim that $\Hom_A(M,N)$ is a finitely generated $A$-module.
  Take presentations $A^l\to A^m\to M\to 0$ and $A^l\to A^n\to N\to 0$, so that the following diagram commutes.
  \[
    \begin{tikzcd}
      A^{m\times n}\cong \Hom(A^m,A^n)\ar[r,twoheadrightarrow] & \Hom(A^m, N)\\
                                            &\Hom(M,N)\ar[u,hook]
    \end{tikzcd}
  \] 
  Then $\Hom(M,N)$ is a submodule of a finitely generated module, and thus finitely generated since $A$ is noetherian.

  In particular, we can take a distinguished affine $D(f)\subset \Spec A$ for $f\in A$, and see via (6.2) that
  \begin{align*}
    \Hom_{\O_{D(f)}}(\F|_{D(f)}),\G|_{D(f)})
      &\cong \Hom_{A_f}(M_f,N_f).
  \end{align*}
  We claim that
  \[
    \Hom_{A_f}(M_f,N_f) \cong \Hom_A(M,N)_f,
  \] 
  whence it would follow from the above that
  \[
    \sHom_{\O_U}(\F|_U,\G|_U)\cong \wtilde{\Hom_A(M,N)}.
  \] 
  Fix presentations $A^l\to A^m\to M\to 0$ and $A^l\to A^n\to N\to 0$ as before.
  Clearly the result holds when $M$, $N$ are both free modules, as 
  \[
    \Hom_A(A^m,A^l)_f\cong A^{m\times l}_f \cong \Hom_{A_f}(A_f^m,A_f^l).
  \]
  Localization is exact, so the following sequence is exact,
  \[
    \begin{tikzcd}
      \Hom_{A_f}(A^m_f,A^l_f)\ar[r] &\Hom_{A_f}(A^m_f,A^n_f)\ar[r] &\Hom_A(A^m, N)_f\ar[r]& 0
    \end{tikzcd}
  \] 
  whence
  \[
    \Hom_A(A^m,N)_f\cong \frac{\Hom_{A_f}(A_f^m,A_f^n)}{\Hom_{A_f}(A_f^m,A_f^l)} \cong \Hom_{A_f}(A^m_f,N_f).
  \] 
  That is, the result holds when $M$ is free.
  Finally, the same trick gives us exactness of the following diagram,
